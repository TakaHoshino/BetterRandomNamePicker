<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BetterRNP</AssemblyName>
    <RootNamespace>BetterRNP</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterRNP.ico</ApplicationIcon>
    <Version>2.2.0</Version>
    <Authors>BetterRNP</Authors>
    <Description>课堂与活动场景的多功能随机抽取器</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BetterRNP.PluginSdk\BetterRNP.PluginSdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\BetterRNP.ico" />
  </ItemGroup>
</Project>
