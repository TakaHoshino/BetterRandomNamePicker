<Window x:Class="BetterRNP.Views.SeatSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpSeatSettings}"
        Width="780"
        Height="700"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Ui.Rows}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="RowsInput" Grid.Column="1" Width="80" />
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource Ui.Columns}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="ColsInput" Grid.Column="3" Width="80" />
                <Button Grid.Column="4"
                        Content="{DynamicResource Ui.UpdateLayout}"
                        Style="{StaticResource SecondaryButton}"
                        Click="UpdateLayout_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14"
                Style="{StaticResource CardStyle}"
                Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <UniformGrid x:Name="SeatGrid" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="Transparent"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                CornerRadius="0"
                Padding="12">
            <TextBlock x:Name="ResultText"
                       Text="{DynamicResource Ui.SetSeatsToStartPicking}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextAlignment="Center" />
        </Border>

        <UniformGrid Grid.Row="3" Columns="3" Margin="0,12,0,0">
            <Button x:Name="PickButton"
                    Content="{DynamicResource Ui.Start}"
                    Style="{StaticResource PrimaryButton}"
                    Click="Pick_Click" />
            <Button Content="{DynamicResource Ui.SaveSettings}"
                    Style="{StaticResource SecondaryButton}"
                    Click="Save_Click" />
            <Button Content="{DynamicResource Ui.ApplyToScheme}"
                    Style="{StaticResource SecondaryButton}"
                    Click="Apply_Click" />
        </UniformGrid>
    </Grid>
</Window>
