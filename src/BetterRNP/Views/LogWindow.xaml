<Window x:Class="BetterRNP.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpLogViewer}"
        Width="1000"
        Height="640"
        MinWidth="760"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Ui.Level}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="LevelCombo"
                          Width="110"
                          VerticalAlignment="Center"
                          SelectionChanged="Filter_SelectionChanged" />
                <TextBlock Text="{DynamicResource Ui.Search}" VerticalAlignment="Center" Margin="16,0,6,0" />
                <TextBox x:Name="SearchBox"
                         Width="220"
                         VerticalAlignment="Center"
                         ToolTip="{DynamicResource Ui.FilterByOperationOrDetails}"
                         TextChanged="Filter_TextChanged" />
                <CheckBox x:Name="AutoRefreshCheck"
                          Content="{DynamicResource Ui.AutoRefresh}"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          Checked="AutoRefresh_Changed"
                          Unchecked="AutoRefresh_Changed" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{DynamicResource Ui.Refresh}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click" />
                <Button Content="{DynamicResource Ui.OpenLogFolder}"
                        Style="{StaticResource SecondaryButton}"
                        Click="OpenFolder_Click" />
                <Button Content="{DynamicResource Ui.Export}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Export_Click" />
                <Button Content="{DynamicResource Ui.Clear}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="EntriesGrid"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                  Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
            <DataGrid.RowStyle>
                <Style TargetType="{x:Type DataGridRow}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LevelText}" Value="警告">
                            <Setter Property="Foreground" Value="#B26A00" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LevelText}" Value="错误">
                            <Setter Property="Foreground" Value="#C03030" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Ui.Time}" Binding="{Binding TimeText}" Width="170" />
                <DataGridTextColumn Header="{DynamicResource Ui.Level}" Binding="{Binding LevelText}" Width="64" />
                <DataGridTextColumn Header="{DynamicResource Ui.Actions}" Binding="{Binding Operation}" Width="190" />
                <DataGridTextColumn Header="{DynamicResource Ui.Details}" Binding="{Binding Detail}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding Detail}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Margin="2,0,110,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Button Content="{DynamicResource Ui.Close}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
