<Window x:Class="BetterRNP.Views.NameConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpNameConfiguration}"
        Width="820"
        Height="600"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Ui.SelectScheme}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="SchemeCombo"
                          Width="300"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SchemeCombo_SelectionChanged" />
                <TextBlock x:Name="CountText"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14"
                Style="{StaticResource CardStyle}"
                Padding="10">
            <ListBox x:Name="NameList"
                     ItemsSource="{Binding}"
                     SelectionMode="Extended"
                     FontSize="16" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="NameInput"
                         Grid.Row="0"
                         Grid.Column="0"
                         KeyDown="NameInput_KeyDown" />
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="{DynamicResource Ui.Add}"
                            Style="{StaticResource SecondaryButton}"
                            Click="Add_Click" />
                    <Button Content="{DynamicResource Ui.DeleteSelected}"
                            Style="{StaticResource SecondaryButton}"
                            Click="Delete_Click" />
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,0">
                    <Button Content="{DynamicResource Ui.ImportTxt}"
                            Style="{StaticResource SecondaryButton}"
                            Click="Import_Click" />
                    <Button Content="{DynamicResource Ui.ExportTxt}"
                            Style="{StaticResource SecondaryButton}"
                            Click="Export_Click" />
                    <Button Content="{DynamicResource Ui.Save}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="110"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
