<Window x:Class="BetterRNP.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterRNP - 插件管理"
        Width="920"
        Height="500"
        MinWidth="760"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="加载 .rnpp 插件…"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="LoadPluginButton_Click" />
            <Button x:Name="RemoveButton"
                    Content="移除所选插件"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="RemoveButton_Click" />
            <Button Content="刷新"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="RefreshButton_Click" />
            <TextBlock x:Name="PluginDirLabel"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <ListView x:Name="PluginList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="PluginList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称"
                                    Width="220"
                                    DisplayMemberBinding="{Binding DisplayName}" />
                    <GridViewColumn Header="标识"
                                    Width="190"
                                    DisplayMemberBinding="{Binding Manifest.Id}" />
                    <GridViewColumn Header="作者"
                                    Width="100"
                                    DisplayMemberBinding="{Binding Manifest.Author}" />
                    <GridViewColumn Header="来源"
                                    Width="150"
                                    DisplayMemberBinding="{Binding SourceLabel}" />
                    <GridViewColumn Header="类型"
                                    Width="80"
                                    DisplayMemberBinding="{Binding TypeLabel}" />
                    <GridViewColumn Header="状态"
                                    Width="70"
                                    DisplayMemberBinding="{Binding StateLabel}" />
                    <GridViewColumn Header="操作" Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ToggleText}"
                                        IsEnabled="{Binding CanToggle}"
                                        Padding="6,2"
                                        Tag="{Binding Manifest.Id}"
                                        Click="ToggleButton_Click" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <Button Content="关闭"
                    Width="90"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="内置核心不可移除。外部插件以 .rnpp 包加载，启用/禁用状态会持久化保存；禁用后其命令与自定义抽取模式立即从主窗口移除。" />
        </DockPanel>
    </Grid>
</Window>
