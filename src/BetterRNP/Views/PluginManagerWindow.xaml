<Window x:Class="BetterRNP.Views.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpPluginManager}"
        Width="920"
        Height="500"
        MinWidth="760"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="{DynamicResource Ui.LoadRnppPlugin}"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="LoadPluginButton_Click" />
            <Button x:Name="RemoveButton"
                    Content="{DynamicResource Ui.RemoveSelectedPlugin}"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="RemoveButton_Click" />
            <Button Content="{DynamicResource Ui.Refresh}"
                    Padding="10,4"
                    Margin="0,0,8,0"
                    Click="RefreshButton_Click" />
            <TextBlock x:Name="PluginDirLabel"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <DataGrid x:Name="PluginList"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  GridLinesVisibility="Horizontal"
                  SelectionChanged="PluginList_SelectionChanged">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="SeparatorVisibility" Value="Collapsed" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Ui.Name}"
                                    Width="220"
                                    Binding="{Binding DisplayName}" />
                <DataGridTextColumn Header="{DynamicResource Ui.Id}"
                                    Width="190"
                                    Binding="{Binding Manifest.Id}" />
                <DataGridTextColumn Header="{DynamicResource Ui.Author}"
                                    Width="100"
                                    Binding="{Binding Manifest.Author}" />
                <DataGridTextColumn Header="{DynamicResource Ui.Source}"
                                    Width="150"
                                    Binding="{Binding SourceLabel}" />
                <DataGridTextColumn Header="{DynamicResource Ui.Type}"
                                    Width="80"
                                    Binding="{Binding TypeLabel}" />
                <DataGridTextColumn Header="{DynamicResource Ui.Status}"
                                    Width="70"
                                    Binding="{Binding StateLabel}" />
                <DataGridTemplateColumn Header="{DynamicResource Ui.Actions}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ToggleText}"
                                    IsEnabled="{Binding CanToggle}"
                                    Padding="6,2"
                                    Tag="{Binding Manifest.Id}"
                                    Click="ToggleButton_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <Button Content="{DynamicResource Ui.Close}"
                    Width="90"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="CloseButton_Click" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="{DynamicResource Ui.TheBuiltInCoreCannotBeRemovedExternalPluginsLoadFromRnppPackagesAndEnabledDisabledStateIsPersistedDisablingAPluginRemovesItsCommandsAndCustomModesImmediately}" />
        </DockPanel>
    </Grid>
</Window>
