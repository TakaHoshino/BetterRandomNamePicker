<Window x:Class="BetterRNP.Views.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpBackgroundTheme}"
        Width="960"
        Height="690"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="EnabledCheck"
                          Content="{DynamicResource Ui.EnablePhotoBackground}"
                          VerticalAlignment="Center"
                          Click="Enabled_Click" />
                <Button Content="{DynamicResource Ui.ImportImage}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Import_Click" />
                <Button Content="{DynamicResource Ui.DeleteSelectedImage}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Delete_Click" />
                <Button Content="{DynamicResource Ui.RestoreDefaults2}"
                        Style="{StaticResource SecondaryButton}"
                        Click="Reset_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Ui.ImageLibrary}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <ListBox x:Name="ImageList"
                             Grid.Row="1"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="ImageList_SelectionChanged"
                             MouseDoubleClick="ImageList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="96"
                                            Height="62"
                                            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Ui.NoPreview}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding Preview}"
                                                   Stretch="Uniform"
                                                   Margin="2"
                                                   ToolTip="{Binding Path}">
                                                <Image.Style>
                                                    <Style TargetType="{x:Type Image}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Ui.GlobalBackground}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Ui.Image}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="GlobalImageCombo"
                                      Grid.Column="1"
                                      SelectionChanged="GlobalImage_SelectionChanged" />
                            <TextBlock Grid.Row="1"
                                       Text="{DynamicResource Ui.Fit}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="GlobalModeCombo"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      SelectionChanged="GlobalMode_SelectionChanged" />
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    Content="{DynamicResource Ui.Crop2}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,3,0,3"
                                    Click="GlobalCrop_Click" />
                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource Ui.Mask}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                <Slider x:Name="MaskSlider"
                                        Width="240"
                                        Minimum="0"
                                        Maximum="180"
                                        TickFrequency="10"
                                        ValueChanged="MaskSlider_ValueChanged" />
                                <TextBlock x:Name="MaskValue"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,18" />

                        <TextBlock Text="{DynamicResource Ui.PerWindowCategory}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="CategoryList"
                                     Grid.Column="0"
                                     SelectionChanged="CategoryList_SelectionChanged" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{DynamicResource Ui.ImageInheritGlobalUsesTheGlobalImage}"
                                           Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="CategoryImageCombo"
                                          SelectionChanged="CategoryImage_SelectionChanged" />
                                <TextBlock Text="{DynamicResource Ui.FitMode}"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,8,0,0" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CategoryModeCombo"
                                              SelectionChanged="CategoryMode_SelectionChanged" />
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource Ui.Crop2}"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="8,3,0,3"
                                            Click="CategoryCrop_Click" />
                                </Grid>
                                <Button Content="{DynamicResource Ui.ClearCategorySettings}"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Click="ClearCategory_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock Text="{DynamicResource Ui.AllChangesAreAppliedAndSavedImmediately}"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <Button Content="{DynamicResource Ui.Close}"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="110"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
