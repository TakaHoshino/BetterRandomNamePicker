<Window x:Class="BetterRNP.Views.ThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterRNP - 背景主题设置"
        Width="960"
        Height="690"
        MinWidth="800"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="EnabledCheck"
                          Content="启用照片背景"
                          VerticalAlignment="Center"
                          Click="Enabled_Click" />
                <Button Content="导入图片…"
                        Style="{StaticResource SecondaryButton}"
                        Click="Import_Click" />
                <Button Content="删除选中图片"
                        Style="{StaticResource SecondaryButton}"
                        Click="Delete_Click" />
                <Button Content="恢复默认"
                        Style="{StaticResource SecondaryButton}"
                        Click="Reset_Click" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="图片库"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />
                    <ListBox x:Name="ImageList"
                             Grid.Row="1"
                             DisplayMemberPath="DisplayName"
                             SelectionChanged="ImageList_SelectionChanged"
                             MouseDoubleClick="ImageList_MouseDoubleClick" />
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="全局背景"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="图片"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="GlobalImageCombo"
                                      Grid.Column="1"
                                      SelectionChanged="GlobalImage_SelectionChanged" />
                            <TextBlock Grid.Row="1"
                                       Text="适配"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="GlobalModeCombo"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      SelectionChanged="GlobalMode_SelectionChanged" />
                            <TextBlock Grid.Row="2"
                                       Text="遮罩"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <StackPanel Grid.Row="2"
                                        Grid.Column="1"
                                        Orientation="Horizontal">
                                <Slider x:Name="MaskSlider"
                                        Width="240"
                                        Minimum="0"
                                        Maximum="180"
                                        TickFrequency="10"
                                        ValueChanged="MaskSlider_ValueChanged" />
                                <TextBlock x:Name="MaskValue"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,18" />

                        <TextBlock Text="按窗口类别指定"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="CategoryList"
                                     Grid.Column="0"
                                     SelectionChanged="CategoryList_SelectionChanged" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="图片（“继承全局”表示使用全局图片）"
                                           Foreground="{StaticResource MutedBrush}" />
                                <ComboBox x:Name="CategoryImageCombo"
                                          SelectionChanged="CategoryImage_SelectionChanged" />
                                <TextBlock Text="适配模式"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,8,0,0" />
                                <ComboBox x:Name="CategoryModeCombo"
                                          SelectionChanged="CategoryMode_SelectionChanged" />
                                <Button Content="清除该类别设置"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left"
                                        Margin="0,12,0,0"
                                        Click="ClearCategory_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock Text="所有修改即时应用并保存"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <Button Content="关闭"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="110"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
