<Window x:Class="BetterRNP.Views.CropImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterRNP - 裁切背景图片"
        Width="900"
        Height="660"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="在图片上按住鼠标左键拖拽选择要保留的区域。"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   Margin="0,0,0,8" />

        <Border Grid.Row="1"
                Background="#202020"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <Grid x:Name="ImageHost">
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True" />
                <Canvas x:Name="OverlayCanvas"
                        Background="Transparent"
                        SizeChanged="OverlayCanvas_SizeChanged"
                        PreviewMouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                        PreviewMouseMove="OverlayCanvas_MouseMove"
                        PreviewMouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
                    <Border x:Name="SelectionBox"
                            Background="#332F6FED"
                            BorderBrush="#FF2F6FED"
                            BorderThickness="2"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionText"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="恢复整图"
                        Style="{StaticResource SecondaryButton}"
                        Click="Reset_Click" />
                <Button Content="确定"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="96"
                        Click="Ok_Click" />
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="96"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
