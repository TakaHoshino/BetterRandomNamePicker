<Window x:Class="BetterRNP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterRNP - 系统设置"
        Width="650"
        Height="690"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="启动与关闭"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <CheckBox x:Name="AutoStartCheck"
                              Content="启用后程序将在 Windows 启动时自动运行"
                              Margin="0,5"
                              Click="AutoStart_Click" />
                    <CheckBox x:Name="MinimizeToTrayCheck"
                              Content="关闭主窗口时最小化到系统托盘"
                              Margin="0,5"
                              Click="MinimizeToTray_Click" />
                    <CheckBox x:Name="AutoShowBallCheck"
                              Content="打开程序后自动显示悬浮球"
                              Margin="0,5"
                              Click="AutoShowBall_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="悬浮球外观"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="半径"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                        <Slider x:Name="RadiusSlider"
                                Grid.Column="1"
                                Minimum="30"
                                Maximum="100"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="RadiusSlider_ValueChanged" />
                        <TextBlock x:Name="RadiusValue"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                        <TextBlock Grid.Row="1"
                                   Text="透明度"
                                   VerticalAlignment="Center"
                                   Margin="0,12,10,0" />
                        <Slider x:Name="OpacitySlider"
                                Grid.Row="1"
                                Grid.Column="1"
                                Minimum="50"
                                Maximum="255"
                                TickFrequency="25"
                                IsSnapToTickEnabled="True"
                                Margin="0,12,0,0"
                                ValueChanged="OpacitySlider_ValueChanged" />
                        <TextBlock x:Name="OpacityValue"
                                   Grid.Row="1"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="12,12,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="背景主题"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <CheckBox x:Name="ThemeEnabledCheck"
                              Content="启用照片背景"
                              Click="ThemeEnabled_Click" />
                    <Button Content="打开背景主题设置…"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            Click="ThemeSettings_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="日志"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <Button Content="导出日志文件"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Click="ExportLog_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="安全"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="LockButton"
                                Style="{StaticResource SecondaryButton}"
                                Click="Lock_Click" />
                        <Button Content="修改密码"
                                Style="{StaticResource SecondaryButton}"
                                Click="ChangePassword_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DefaultPasswordWarning"
                               Text="⚠ 当前仍是内置默认密码，建议点“修改密码”更换"
                               Foreground="#C03030"
                               Margin="2,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Content="关闭"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Margin="0,16,0,0"
                    Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
