<Window x:Class="BetterRNP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpOptions}"
        Width="840"
        Height="680"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1">
                <TreeView x:Name="SettingsNavigation"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="4"
                          SelectedItemChanged="SettingsNavigation_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background"
                                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeViewItem x:Name="GeneralNavigation"
                                  Header="{DynamicResource Ui.General}"
                                  Tag="general" />
                    <TreeViewItem x:Name="LanguageNavigation"
                                  Header="{DynamicResource Ui.Language}"
                                  Tag="language" />
                    <TreeViewItem x:Name="InterfaceNavigation"
                                  Header="{DynamicResource Ui.Interface}"
                                  Tag="interface" />
                    <TreeViewItem x:Name="UpdateNavigation"
                                  Header="{DynamicResource Ui.Updates}"
                                  Tag="update" />
                    <TreeViewItem x:Name="SecurityNavigation"
                                  Header="{DynamicResource Ui.Security}"
                                  Tag="security" />
                    <TreeViewItem x:Name="LogNavigation"
                                  Header="{DynamicResource Ui.Logs}"
                                  Tag="logs" />
                    <TreeViewItem x:Name="PluginsNavigation"
                                  Header="{DynamicResource Ui.Plugins}"
                                  Tag="plugins" />
                </TreeView>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SettingsPageTitle"
                           Text="{DynamicResource Ui.General}"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Margin="2,0,0,8" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="2,0,12,12">
                        <StackPanel x:Name="GeneralPage">
                            <TextBlock Text="{DynamicResource Ui.StartupAndCloseBehavior}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <CheckBox x:Name="AutoStartCheck"
                                      Content="{DynamicResource Ui.RunAutomaticallyWhenWindowsStarts}"
                                      Margin="0,5"
                                      Click="AutoStart_Click" />
                            <CheckBox x:Name="MinimizeToTrayCheck"
                                      Content="{DynamicResource Ui.MinimizeToTheSystemTrayWhenTheMainWindowCloses}"
                                      Margin="0,5"
                                      Click="MinimizeToTray_Click" />
                            <CheckBox x:Name="AutoShowBallCheck"
                                      Content="{DynamicResource Ui.ShowTheFloatingBallAfterStartup}"
                                      Margin="0,5"
                                      Click="AutoShowBall_Click" />
                        </StackPanel>

                        <StackPanel x:Name="LanguagePage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.DisplayLanguage}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <TextBlock Text="{DynamicResource Ui.ChooseTheInterfaceLanguageChangesAreAppliedToOpenWindowsImmediately}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10" />
                            <ComboBox x:Name="LanguageCombo"
                                      Width="260"
                                      HorizontalAlignment="Left"
                                      Tag="__i18n_ignore__"
                                      SelectionChanged="LanguageCombo_SelectionChanged">
                <ComboBoxItem Content="{DynamicResource Language.SimplifiedChinese}" Tag="zh-Hans" />
                <ComboBoxItem Content="{DynamicResource Language.TraditionalChinese}" Tag="zh-Hant" />
                <ComboBoxItem Content="{DynamicResource Language.Cantonese}" Tag="zh-HK" />
                <ComboBoxItem Content="{DynamicResource Language.English}" Tag="en-US" />
                <ComboBoxItem Content="{DynamicResource Language.Russian}" Tag="ru-RU" />
                <ComboBoxItem Content="{DynamicResource Language.Japanese}" Tag="ja-JP" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Ui.TheLanguageSettingIsSavedInTheConfigurationFileAndUsedOnTheNextLaunch}"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="InterfacePage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.FloatingBallAppearance}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource Ui.Radius}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <Slider x:Name="RadiusSlider"
                                        Grid.Column="1"
                                        Minimum="30"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="5"
                                        IsMoveToPointEnabled="True"
                                        ValueChanged="RadiusSlider_ValueChanged" />
                                <TextBlock x:Name="RadiusValue"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource Ui.Opacity}"
                                           VerticalAlignment="Center"
                                           Margin="0,12,10,0" />
                                <Slider x:Name="OpacitySlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Minimum="50"
                                        Maximum="255"
                                        SmallChange="1"
                                        LargeChange="10"
                                        IsMoveToPointEnabled="True"
                                        Margin="0,12,0,0"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                                <TextBlock x:Name="OpacityValue"
                                           Grid.Row="1"
                                           Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Margin="12,12,0,0" />
                            </Grid>
                            <Button x:Name="ResetBallDefaultsButton"
                                    Content="{DynamicResource Ui.RestoreDefaults}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,14,0,0"
                                    Click="ResetFloatingBallDefaults_Click" />

                            <Separator Margin="0,18,0,14" />
                            <TextBlock Text="{DynamicResource Ui.BackgroundTheme}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <CheckBox x:Name="ThemeEnabledCheck"
                                      Content="{DynamicResource Ui.EnablePhotoBackground}"
                                      Click="ThemeEnabled_Click" />
                            <Button Content="{DynamicResource Ui.OpenBackgroundThemeSettings}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    Click="ThemeSettings_Click" />
                        </StackPanel>

                        <StackPanel x:Name="UpdatePage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.UpdateChecks}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <CheckBox x:Name="CheckOnStartupCheck"
                                      Content="{DynamicResource Ui.CheckForUpdatesAtStartup}"
                                      Margin="0,4"
                                      Click="UpdateSetting_Click" />
                            <TextBlock Text="{DynamicResource Ui.UpdateDownloadSource}"
                                       Margin="0,8,0,2" />
                            <RadioButton x:Name="OfficialSourceRadio"
                                         Content="{DynamicResource Ui.OfficialSourceGithubComDirect}"
                                         GroupName="UpdateSource"
                                         Margin="0,2"
                                         Click="UpdateSetting_Click" />
                            <RadioButton x:Name="ProxySourceRadio"
                                         Content="{DynamicResource Ui.GhProxyMirrorAccelerated}"
                                         GroupName="UpdateSource"
                                         Margin="0,2"
                                         Click="UpdateSetting_Click" />
                            <TextBlock x:Name="InstallTypeText"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="CheckNowButton"
                                        Content="{DynamicResource Ui.CheckForUpdatesNow}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="CheckNow_Click" />
                                <TextBlock x:Name="UpdateStatusText"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.UpdatesUseGithubReleasesSettingsAreStoredInDataUpdateJson}"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="SecurityPage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.ConfigurationSecurity}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LockButton"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="Lock_Click" />
                                <Button Content="{DynamicResource Ui.ChangePassword}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ChangePassword_Click" />
                            </StackPanel>
                            <TextBlock x:Name="DefaultPasswordWarning"
                                       Text="{DynamicResource Ui.TheBuiltInDefaultPasswordIsStillInUseUseChangePasswordToReplaceIt}"
                                       Foreground="#C03030"
                                       Margin="2,10,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel x:Name="LogPage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.OperationLogs}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{DynamicResource Ui.ViewLogs}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ViewLog_Click" />
                                <Button Content="{DynamicResource Ui.ExportLogFile}"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ExportLog_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LogPathText"
                                       FontSize="11"
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       TextWrapping="Wrap"
                                       Margin="2,8,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="PluginsOverviewPage" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Ui.PluginSettings}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10" />
                            <TextBlock x:Name="PluginSummaryText"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12" />
                            <Button Content="{DynamicResource Ui.OpenPluginManager}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Click="OpenPluginManager_Click" />
                        </StackPanel>

                        <ContentControl x:Name="PluginSettingsHost"
                                        Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Padding="12,8"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="{DynamicResource Ui.FloatingBallChangesApplyImmediatelyAndAreSavedAfterYouStopDragging}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="{DynamicResource Ui.Close}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="110"
                            IsDefault="True"
                            Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
