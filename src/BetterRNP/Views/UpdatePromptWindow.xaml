<Window x:Class="BetterRNP.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpCheckForUpdates}"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <TextBlock x:Name="DetectedTypeText"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBlock Text="{DynamicResource Ui.ReleaseNotes}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBox x:Name="ReleaseNotesBox"
                 Height="180"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas"
                 FontSize="12"
                 Margin="0,0,0,10" />

        <TextBlock Text="{DynamicResource Ui.ChooseTheDownloadTheDifferenceIsWhetherTheNetRuntimeIsBundled}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <RadioButton x:Name="SelfContainedRadio"
                     GroupName="AssetKind"
                     Margin="0,4,0,0"
                     HorizontalContentAlignment="Left">
            <StackPanel Margin="4,0,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{DynamicResource Ui.SelfContainedRecommended}" />
                    <Run x:Name="SelfContainedSizeText" />
                </TextBlock>
                <TextBlock Text="{DynamicResource Ui.IncludesTheNet8RuntimeRequiresNoSetupAndRunsAfterExtractionLargerDownload}"
                           FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="FrameworkRadio"
                     GroupName="AssetKind"
                     Margin="0,8,0,0"
                     HorizontalContentAlignment="Left">
            <StackPanel Margin="4,0,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{DynamicResource Ui.FrameworkDependent}" />
                    <Run x:Name="FrameworkSizeText" />
                </TextBlock>
                <TextBlock Text="{DynamicResource Ui.SmallerDownloadButTheTargetComputerMustHaveNet8DesktopRuntimeInstalled}"
                           FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="UpdateButton"
                    Content="{DynamicResource Ui.StartUpdate}"
                    Width="96"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="UpdateButton_Click" />
            <Button x:Name="LaterButton"
                    Content="{DynamicResource Ui.NotNow}"
                    Width="96"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
