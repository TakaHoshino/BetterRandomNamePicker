<Window x:Class="BetterRNP.Views.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterRNP - 检查更新"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <TextBlock x:Name="SummaryText"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <TextBlock x:Name="DetectedTypeText"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <TextBlock Text="Release Notes"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBox x:Name="ReleaseNotesBox"
                 Height="180"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas"
                 FontSize="12"
                 Margin="0,0,0,10" />

        <TextBlock Text="选择要下载的版本（区别在于是否内置 .NET 运行时）："
                   TextWrapping="Wrap"
                   Margin="0,0,0,6" />

        <RadioButton x:Name="SelfContainedRadio"
                     GroupName="AssetKind"
                     Margin="0,4,0,0"
                     HorizontalContentAlignment="Left">
            <StackPanel Margin="4,0,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="自包含版（推荐）" />
                    <Run x:Name="SelfContainedSizeText" />
                </TextBlock>
                <TextBlock Text="已内置 .NET 8 运行时，无需安装环境，解压后直接运行；体积较大。"
                           FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="FrameworkRadio"
                     GroupName="AssetKind"
                     Margin="0,8,0,0"
                     HorizontalContentAlignment="Left">
            <StackPanel Margin="4,0,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="框架依赖版" />
                    <Run x:Name="FrameworkSizeText" />
                </TextBlock>
                <TextBlock Text="体积较小，但目标机器必须安装 .NET 8 Desktop Runtime。"
                           FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </RadioButton>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="UpdateButton"
                    Content="开始更新"
                    Width="96"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="UpdateButton_Click" />
            <Button x:Name="LaterButton"
                    Content="暂不"
                    Width="96"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
