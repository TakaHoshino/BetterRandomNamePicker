<Window x:Class="BetterRNP.Views.SchemeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.BetterrnpSchemeManager}"
        Width="560"
        Height="570"
        MinWidth="500"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Ui.SchemeName}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="SchemeNameInput"
                         Grid.Column="1" />
                <ComboBox x:Name="TypeCombo"
                          Grid.Column="2"
                          Width="130"
                          Margin="10,4,10,4">
            <ComboBoxItem Content="{DynamicResource Ui.NameList}" Tag="name_list" IsSelected="True" />
            <ComboBoxItem Content="{DynamicResource Ui.Numbers}" Tag="number" />
            <ComboBoxItem Content="{DynamicResource Ui.Seats}" Tag="seat" />
                </ComboBox>
                <Button Grid.Column="3"
                        Content="{DynamicResource Ui.CreateScheme}"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="110"
                        Click="Create_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14"
                Style="{StaticResource CardStyle}"
                Padding="10">
            <ListBox x:Name="SchemeList"
                     DisplayMemberPath="DisplayName"
                     FontSize="16" />
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource Ui.DeleteSelectedScheme}"
                    Style="{StaticResource SecondaryButton}"
                    Click="Delete_Click" />
            <Button Content="{DynamicResource Ui.Close}"
                    Style="{StaticResource SecondaryButton}"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
